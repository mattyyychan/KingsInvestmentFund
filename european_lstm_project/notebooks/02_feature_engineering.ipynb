    "missing = final_features.isnull().sum()\n",
    "missing_pct = (missing / len(final_features)) * 100\n",
    "\n",
    "missing_summary = pd.DataFrame({\n",
    "    'Missing': missing,\n",
    "    'Percentage': missing_pct\n",
    "}).sort_values('Missing', ascending=False)\n",
    "\n",
