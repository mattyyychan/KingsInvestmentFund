    "final_features = final_features.dropna(subset=['target', 'residual_return'])\n",
    "after = len(final_features)\n",
    "\n",
    "print(f\"\\nDropped {before - after} rows with missing target ({(before-after)/before*100:.2f}%)\")\n",
    "\n",
    "# Forward fill remaining missing values (for fundamental data)\n",
    "numeric_cols = final_features.select_dtypes(include=[np.number]).columns\n",
    "final_features[numeric_cols] = final_features.groupby('gvkey')[numeric_cols].ffill()\n",
    "\n",
    "# Fill any remaining NaN with 0\n",
    "final_features = final_features.fillna(0)\n",
    "\n",
    "print(f\"✓ Final dataset shape: {final_features.shape}\")\n",
    "print(f\"✓ No missing values: {final_features.isnull().sum().sum() == 0}\")"
