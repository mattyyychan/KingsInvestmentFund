   "source": [
    "print(\"Combining all features into final dataset...\")\n",
    "print(\"-\" * 60)\n",
    "\n",
    "# Reshape residuals to long format\n",
    "residuals_long = residuals.reset_index().melt(\n",
    "    id_vars='datadate',\n",
    "    var_name='gvkey',\n",
    "    value_name='residual_return'\n",
    ")\n",
    "residuals_long['datadate'] = pd.to_datetime(residuals_long['datadate'])\n",
    "\n",
    "# Merge PCA features with residuals\n",
    "final_features = pca_features.merge(\n",
    "    residuals_long,\n",
    "    left_on=['date', 'gvkey'],\n",
    "    right_on=['datadate', 'gvkey'],\n",
    "    how='left'\n",
    ").drop('datadate', axis=1)\n",
    "\n",
    "# Add macro features (broadcast to all stocks)\n",
    "final_features = final_features.merge(\n",
    "    macro_features.reset_index().rename(columns={'index': 'date'}),\n",
    "    on='date',\n",
    "    how='left'\n",
    ")\n",
    "\n",
    "# Add fundamentals (forward fill to daily frequency)\n",
    "fundamentals_daily = []\n",
    "for gvkey in final_features['gvkey'].unique():\n",
    "    stock_fundamentals = fundamentals_df[fundamentals_df['gvkey'] == gvkey].copy()\n",
    "    stock_fundamentals = stock_fundamentals.set_index('datadate')\n",
    "    \n",
    "    # Forward fill to daily\n",
    "    stock_fundamentals = stock_fundamentals.resample('D').ffill()\n",
    "    stock_fundamentals['gvkey'] = gvkey\n",
    "    fundamentals_daily.append(stock_fundamentals.reset_index())\n",
    "\n",
    "fundamentals_daily = pd.concat(fundamentals_daily, ignore_index=True)\n",
    "\n",
    "# Select key fundamental features\n",
    "fund_cols = ['gvkey', 'datadate', 'roe', 'roa', 'debt_to_equity', 'current_ratio']\n",
    "fund_cols = [c for c in fund_cols if c in fundamentals_daily.columns]\n",
    "\n",
    "final_features = final_features.merge(\n",
    "    fundamentals_daily[fund_cols],\n",
    "    left_on=['gvkey', 'date'],\n",
    "    right_on=['gvkey', 'datadate'],\n",
    "    how='left'\n",
    ").drop('datadate', axis=1, errors='ignore')\n",
    "\n",
    "print(f\"✓ Final feature set shape: {final_features.shape}\")\n",
    "print(f\"✓ Features: {len(final_features.columns) - 2} (excluding gvkey, date)\")\n",
