    "## 📊 Step 3: Calculate Returns and Market Beta\n",
    "\n",
    "### Academic Foundation (CAPM - Sharpe, 1964):\n",
    "\n",
    "**Capital Asset Pricing Model:**\n",
    "$$E[R_i] = R_f + \\beta_i (E[R_m] - R_f)$$\n",
    "\n",
    "**Beta Estimation:**\n",
    "$$\\beta_i = \\frac{\\text{Cov}(R_i, R_m)}{\\text{Var}(R_m)}$$\n",
    "\n",
    "We use a **60-day rolling window** to capture time-varying beta (Ferson & Harvey, 1991)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Prepare price data\n",
    "print(\"Calculating stock and market returns...\")\n",
    "\n",
    "# Create pivot table: dates × stocks\n",
    "price_pivot = prices_df.pivot_table(\n",
    "    index='datadate',\n",
    "    columns='gvkey',\n",
    "    values='prccd'\n",
    ").sort_index()\n",
    "\n",
    "# Calculate stock returns\n",
    "stock_returns = price_pivot.pct_change()\n",
    "\n",
    "# Market returns (STOXX 600)\n",
    "market_returns = benchmark_df['return'].copy()\n",
    "market_returns.index = pd.to_datetime(market_returns.index)\n",
    "\n",
    "# Align dates\n",
    "common_dates = stock_returns.index.intersection(market_returns.index)\n",
    "stock_returns = stock_returns.loc[common_dates]\n",
    "market_returns = market_returns.loc[common_dates]\n",
    "\n",
    "print(f\"✓ Stock returns shape: {stock_returns.shape}\")\n",
    "print(f\"✓ Date range: {stock_returns.index.min()} to {stock_returns.index.max()}\")\n",
    "print(f\"✓ Trading days: {len(stock_returns)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Initialize residual calculator\n",
    "residual_calc = ResidualReturnCalculator(beta_window=config.BETA_WINDOW)\n",
    "\n",
    "print(f\"\\nCalculating rolling {config.BETA_WINDOW}-day beta for each stock...\")\n",
    "print(\"This may take a few minutes...\")\n",
    "print(\"-\" * 60)\n",
    "\n",
    "# Calculate beta and residuals for each stock\n",
    "betas = pd.DataFrame(index=stock_returns.index)\n",
    "residuals = pd.DataFrame(index=stock_returns.index)\n",
    "\n",
    "for gvkey in tqdm(stock_returns.columns, desc=\"Processing stocks\"):\n",
    "    stock_ret = stock_returns[gvkey]\n",
    "    \n",
    "    # Calculate rolling beta\n",
    "    beta = residual_calc.calculate_rolling_beta(stock_ret, market_returns)\n",
    "    betas[gvkey] = beta\n",
    "    \n",
    "    # Calculate residual returns\n",
    "    residual = residual_calc.calculate_residual_returns(\n",
    "        stock_ret,\n",
    "        market_returns,\n",
    "        beta\n",
    "    )\n",
    "    residuals[gvkey] = residual\n",
    "\n",
    "print(f\"\\n✓ Calculated betas and residuals for {len(stock_returns.columns)} stocks\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Analyze beta distribution\n",
    "print(\"\\n📊 Beta Statistics:\")\n",
    "print(\"-\" * 60)\n",
    "\n",
    "latest_betas = betas.iloc[-1].dropna()\n",
    "print(f\"Mean beta: {latest_betas.mean():.2f}\")\n",
    "print(f\"Median beta: {latest_betas.median():.2f}\")\n",
    "print(f\"Std dev: {latest_betas.std():.2f}\")\n",
    "print(f\"Min: {latest_betas.min():.2f}, Max: {latest_betas.max():.2f}\")\n",
    "\n",
    "# Plot beta distribution\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Histogram\n",
    "axes[0].hist(latest_betas, bins=20, edgecolor='black', alpha=0.7)\n",
    "axes[0].axvline(latest_betas.mean(), color='red', linestyle='--', label=f'Mean: {latest_betas.mean():.2f}')\n",
    "axes[0].axvline(1.0, color='green', linestyle='--', label='Market Beta = 1.0')\n",
    "axes[0].set_xlabel('Beta')\n",
    "axes[0].set_ylabel('Frequency')\n",
    "axes[0].set_title('Distribution of Stock Betas (Latest)')\n",
    "axes[0].legend()\n",
    "axes[0].grid(True, alpha=0.3)\n",
    "\n",
    "# Time series of average beta\n",
    "avg_beta_ts = betas.mean(axis=1)\n",
    "axes[1].plot(avg_beta_ts.index, avg_beta_ts, linewidth=2)\n",
    "axes[1].axhline(1.0, color='green', linestyle='--', alpha=0.5, label='Market Beta = 1.0')\n",
    "axes[1].set_xlabel('Date')\n",
    "axes[1].set_ylabel('Average Beta')\n",
    "axes[1].set_title('Time Series of Portfolio Average Beta')\n",
    "axes[1].legend()\n",
    "axes[1].grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\n💡 Interpretation:\")\n",
    "print(\"   - Beta = 1.0: Stock moves with market\")\n",
    "print(\"   - Beta > 1.0: Stock is more volatile than market (aggressive)\")\n",
    "print(\"   - Beta < 1.0: Stock is less volatile than market (defensive)\")"
   ]
