    "    residual_returns=final_features['residual_return'],\n",
    "    threshold=0.0\n",
    ")\n",
    "\n",
    "# Analyze target distribution\n",
    "target_counts = final_features['target'].value_counts()\n",
    "print(f\"\\nTarget distribution:\")\n",
    "print(f\"  Positive residual returns (1): {target_counts.get(1, 0):,} ({target_counts.get(1, 0)/len(final_features)*100:.1f}%)\")\n",
    "print(f\"  Negative residual returns (0): {target_counts.get(0, 0):,} ({target_counts.get(0, 0)/len(final_features)*100:.1f}%)\")\n",
    "\n",
    "if abs(target_counts.get(1, 0)/len(final_features) - 0.5) > 0.1:\n",
    "    print(\"\\n⚠️  Warning: Target is imbalanced. Consider class weights in LSTM training.\")\n",
    "else:\n",
    "    print(\"\\n✓ Target is reasonably balanced.\")\n",
    "\n",
    "# Visualize target over time\n",
    "target_by_date = final_features.groupby('date')['target'].mean()\n",
    "\n",
    "plt.figure(figsize=(14, 6))\n",
    "plt.plot(target_by_date.index, target_by_date, linewidth=1, alpha=0.7)\n",
    "plt.axhline(0.5, color='red', linestyle='--', label='Balanced (50%)')\n",
    "plt.fill_between(target_by_date.index, 0.4, 0.6, alpha=0.2, color='green', label='Balanced range')\n",
    "plt.xlabel('Date')\n",
    "plt.ylabel('Fraction with Positive Residual Return')\n",
    "plt.title('Time Series of Target Variable (Daily Average Across Stocks)')\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()"
