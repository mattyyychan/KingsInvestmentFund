    "print(f\"  - PCA components: {n_components}\")\n",
    "print(f\"  - Macro variables: {len(macro_features.columns)}\")\n",
    "print(f\"  - Fundamentals: {len([c for c in fund_cols if c not in ['gvkey', 'datadate']])}\")\n",
    "print(f\"  - Residual return: 1\")\n",
    "\n",
    "final_features.head()"
